# Copia questo file in ".env" (stessa cartella) e personalizza i valori.

# Porta LAN su cui sarà raggiungibile l'app (es. http://192.168.1.50:8080)
PORT=8080

# Password unica per evitare accessi accidentali. Lascia vuoto per nessuna protezione.
APP_PASSWORD=

# Chiave segreta usata per firmare il token di accesso. Cambiala con una stringa lunga e casuale.
APP_SECRET=cambia-questa-chiave-con-una-stringa-lunga-e-casuale
